{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "PIUWeb Single Player",
  "short_name": "PIUWeb",
  "description": "Pump It Up single player com recordes locais",
  "start_url": "./index.html",
  "display_override": [
    "fullscreen",
    "minimal-ui"
  ],
  "display": "standalone",
  "theme_color": "#10151c",
  "lang": "pt-BR",
  "background_color": "#10151c",
  "orientation": "portrait",
  "icons": [
    {
      "src": "icon/piuweb32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "icon/piuweb60.png",
      "sizes": "60x60",
      "type": "image/png"
    },
    {
      "src": "icon/piuweb80.png",
      "sizes": "80x80",
      "type": "image/png"
    },
    {
      "src": "icon/piuweb128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "icon/piuweb192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon/piuweb256.png",
      "sizes": "256x256",
      "type": "image/png"
    },
    {
      "src": "icon/piuweb512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "url_handlers": [
    {
      "origin": "/piuweb_phoenix"
    }
  ]
}
